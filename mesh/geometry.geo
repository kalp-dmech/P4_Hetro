SetFactory("OpenCASCADE");

// ======================================================
// HETEROGENEOUS PLATE WITH EDGE CRACK
// QUAD DOMINANT
// gmsh 4.8.4
// ======================================================

// ======================================================
// PARAMETERS
// ======================================================

h = 0.01;
h_inclusion = 0.004;

// ======================================================
// POINTS
// ======================================================

// corners
Point(1) = {0,0,0,h};
Point(2) = {1,0,0,h};
Point(3) = {1,1,0,h};
Point(4) = {0,1,0,h};

// crack mouth
Point(5) = {0,0.499,0,h_inclusion};
Point(6) = {0,0.501,0,h_inclusion};

// crack tip
Point(7) = {0.5,0.499,0,h_inclusion};
Point(8) = {0.5,0.501,0,h_inclusion};

// ======================================================
// BOUNDARY LINES
// ======================================================

// bottom
Line(1) = {1,2};

// left lower
Line(2) = {1,5};

// right
Line(3) = {2,3};

// crack lower
Line(4) = {5,7};

// top
Line(5) = {3,4};

// crack upper
Line(6) = {8,6};

// left upper
Line(7) = {6,4};

// crack tip connector
Line(8) = {7,8};

// ======================================================
// SURFACE
// ======================================================

Curve Loop(1) =
{
1,
3,
5,
-7,
-6,
-8,
-4,
-2
};

Plane Surface(1) = {1};

// ======================================================
// 50 INCLUSIONS
// ======================================================

Disk(20)  = {0.46620,0.46672,0,0.00954,0.00954};
