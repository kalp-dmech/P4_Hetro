Disk(69)  = {0.62118,0.48799,0,0.01128,0.01128};

// ======================================================
// BOOLEAN FRAGMENT
// ======================================================

BooleanFragments{ Surface{1}; Delete; }
{
  Surface{20:69}; Delete;
}

Coherence;

// ======================================================
// PHYSICAL SURFACES
// ======================================================

inclusion_surfaces[] = {20:69};

all_surfaces[] = Surface{:};

matrix_surfaces[] = all_surfaces[];
matrix_surfaces[] -= inclusion_surfaces[];

Physical Surface("material_1",1) =
{
matrix_surfaces[]
};

Physical Surface("material_2",2) =
{
inclusion_surfaces[]
};

// ======================================================
// PHYSICAL CURVES
// ======================================================

// bottom
Physical Curve("bottom",1) = {1};

// right
Physical Curve("right",2) = {3};

// top
Physical Curve("top",3) = {5};

// left
Physical Curve("left",4) = {2,7};

// crack
Physical Curve("crack",5) = {4,8,6};

// ======================================================
// LOCAL REFINEMENT
// ======================================================

MeshSize { PointsOf{ Curve{4,6,8}; } } =
h_inclusion;

MeshSize { PointsOf{ Surface{inclusion_surfaces[]}; } } =
h_inclusion;

// ======================================================
// GLOBAL MESH CONTROL
// ======================================================

Mesh.CharacteristicLengthMin = h_inclusion;

Mesh.CharacteristicLengthMax = h;

// ======================================================
// QUAD DOMINANT SETTINGS
// ======================================================

Mesh.Algorithm = 8;

Mesh.RecombineAll = 1;

Mesh.RecombinationAlgorithm = 2;

Mesh.Smoothing = 5;

Mesh.Optimize = 1;

Mesh.OptimizeNetgen = 1;

Recombine Surface {matrix_surfaces[]};

// ======================================================
// DEAL.II COMPATIBILITY
// ======================================================

Mesh.MshFileVersion = 2.2;
